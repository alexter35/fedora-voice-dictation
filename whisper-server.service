[Unit]
Description=Serveur de dictée Whisper (modèle chargé en VRAM)
Documentation=https://github.com/… fedora-voice-dictation (portage Kubuntu)
After=graphical-session.target
Wants=ydotool.service

[Service]
Type=simple
ExecStart=%h/whisper-env/bin/python3 %h/whisper-server.py
Restart=on-failure
RestartSec=3
# Fichier de config optionnel (WHISPER_MODEL=…, etc.)
EnvironmentFile=-%h/.config/whisper-dictee.conf
# Le serveur ajoute lui-même les libs CUDA pip à LD_LIBRARY_PATH.

[Install]
WantedBy=default.target
